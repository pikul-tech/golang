package main

import (
	"fmt"
	"io"
	"net"
	"os"
	"time"
)

func handleConnection(conn net.Conn) {
	defer conn.Close()

	fmt.Println("Połączenie:", conn.RemoteAddr())

	filename := fmt.Sprintf("print_%s.bin", time.Now().Format("20060102_150405.000"))

	file, err := os.Create(filename)
	if err != nil {
		fmt.Println("Błąd pliku:", err)
		return
	}
	defer file.Close()

	buf := make([]byte, 4096)

	for {
		n, err := conn.Read(buf)

		if n > 0 {
			data := buf[:n]

			fmt.Printf("Odebrano %d bajtów\n", n)

			_, _ = file.Write(data)

			// Tutaj możesz później analizować dane
			// np. ZPL, EPL, TSPL, ESC/POS itd.
		}

		if err != nil {
			if err != io.EOF {
				fmt.Println("Błąd:", err)
			}
			break
		}
	}

	fmt.Println("Rozłączono:", conn.RemoteAddr())
}

func main() {
	listener, err := net.Listen("tcp4", "0.0.0.0:9100")
	//listener, err := net.Listen("tcp", ":9100")
	if err != nil {
		fmt.Println("Nie można uruchomić serwera:", err)
		return
	}
	defer listener.Close()

	fmt.Println("Emulator drukarki nasłuchuje na porcie 9100...")

	for {
		conn, err := listener.Accept()
		if err != nil {
			fmt.Println("Błąd połączenia:", err)
			continue
		}

		go handleConnection(conn)
	}
}